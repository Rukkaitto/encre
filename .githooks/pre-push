#!/bin/sh
# Validate the branch name and every commit this push would add, before any of it
# leaves the machine. Installed by `make hooks`; bypass with `git push --no-verify`.
#
# WHY THE RANGE COMES FROM STDIN rather than being origin/main..HEAD: git hands
# pre-push the remote sha it negotiated for each ref, live. A hardcoded
# origin/main..HEAD reads a remote-tracking ref that can be STALE, and a stale one
# drags already-merged history into the range -- where 128 of main's commits
# predate this rule and would fail it. The negotiated sha cannot be stale.
#
# For a branch the remote does not have yet, that sha is all zeros, and the
# fallback is "commits on no branch of this remote", which is the same question
# asked a different way.
set -e

remote="$1"
root=$(git rev-parse --show-toplevel)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a branch pushes a zero local sha and adds no commits.
    [ "$local_sha" = "$zero" ] && continue
    # Tags and other non-branch refs have no branch name to check.
    case "$local_ref" in
        refs/heads/*) branch=${local_ref#refs/heads/} ;;
        *) continue ;;
    esac

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$remote"
    else
        range="$remote_sha..$local_sha"
    fi

    python3 "$root/tools/check_conventions.py" \
        --branch "$branch" --range "$range" || status=1
done

exit $status
